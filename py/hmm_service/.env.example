# HMM Microservice Configuration

# Service Configuration
HMM_SERVICE_HOST=0.0.0.0
HMM_SERVICE_PORT=8000
HMM_SERVICE_WORKERS=1
HMM_SERVICE_DEBUG=false

# Logging Configuration
HMM_LOG_LEVEL=INFO
HMM_LOG_FORMAT=json

# Security Configuration
HMM_ALLOWED_ORIGINS=*
HMM_ALLOWED_HOSTS=*
# HMM_API_KEY=your-secret-api-key

# Model Configuration
HMM_DEFAULT_EXPERIMENT_ID=production_hmm
HMM_MODEL_RELOAD_INTERVAL=300
HMM_MODEL_VALIDATION_ENABLED=true

# Cache Configuration
HMM_CACHE_SIZE=1000
HMM_CACHE_TTL=300
HMM_CACHE_ENABLED=true

# Performance Configuration
HMM_MAX_CONCURRENT_REQUESTS=100
HMM_REQUEST_TIMEOUT=30.0
HMM_INFERENCE_TIMEOUT=5.0

# Circuit Breaker Configuration
HMM_CIRCUIT_BREAKER_ENABLED=true
HMM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
HMM_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# Health Check Configuration
HMM_HEALTH_CHECK_INTERVAL=30
HMM_STARTUP_TIMEOUT=60

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=hmm-artifacts
MINIO_SECURE=false
MINIO_TIMEOUT=30
MINIO_MAX_POOL_SIZE=10
MINIO_MAX_RETRIES=3
MINIO_RETRY_DELAY=1.0

# Monitoring Configuration
HMM_METRICS_ENABLED=true
HMM_METRICS_PORT=8001

# Resource Limits (optional)
# HMM_MAX_MEMORY_MB=512
# HMM_MAX_CPU_PERCENT=80