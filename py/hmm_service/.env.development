# Development Environment Configuration

# Service Configuration
HMM_SERVICE_HOST=0.0.0.0
HMM_SERVICE_PORT=8000
HMM_SERVICE_WORKERS=1
HMM_SERVICE_DEBUG=true

# Logging Configuration
HMM_LOG_LEVEL=DEBUG
HMM_LOG_FORMAT=text

# Security Configuration (relaxed for development)
HMM_ALLOWED_ORIGINS=*
HMM_ALLOWED_HOSTS=*

# Model Configuration
HMM_DEFAULT_EXPERIMENT_ID=development_hmm
HMM_MODEL_RELOAD_INTERVAL=60
HMM_MODEL_VALIDATION_ENABLED=true

# Cache Configuration (smaller for development)
HMM_CACHE_SIZE=100
HMM_CACHE_TTL=60
HMM_CACHE_ENABLED=true

# Performance Configuration (relaxed for development)
HMM_MAX_CONCURRENT_REQUESTS=10
HMM_REQUEST_TIMEOUT=60.0
HMM_INFERENCE_TIMEOUT=10.0

# Circuit Breaker Configuration (disabled for development)
HMM_CIRCUIT_BREAKER_ENABLED=false
HMM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=10
HMM_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=30

# Health Check Configuration
HMM_HEALTH_CHECK_INTERVAL=10
HMM_STARTUP_TIMEOUT=30

# MinIO Configuration (local development)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=hmm-artifacts-dev
MINIO_SECURE=false
MINIO_TIMEOUT=10
MINIO_MAX_POOL_SIZE=5
MINIO_MAX_RETRIES=2
MINIO_RETRY_DELAY=0.5

# Monitoring Configuration
HMM_METRICS_ENABLED=true
HMM_METRICS_PORT=8001